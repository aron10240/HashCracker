<Window Background="#202020" x:Class="HashCracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HashCracker"
        mc:Ignorable="d"
        Title="HashCracker" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="65*"/>
            <ColumnDefinition Width="29*"/>
            <ColumnDefinition Width="77*"/>
            <ColumnDefinition Width="597*"/>
            <ColumnDefinition Width="32*"/>
        </Grid.ColumnDefinitions>
        <TextBox Name="TBxInput" HorizontalAlignment="Left" Margin="141,217,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="176" Grid.Column="3"/>
        <Button Name="Start" Grid.Column="3" Content="Start" HorizontalAlignment="Left" Margin="141,284,0,0" VerticalAlignment="Top" RenderTransformOrigin="5.446,1.069" Click="Start_Click" Width="60"/>
        <TextBlock Name="TBEncodedHash" Foreground="White" HorizontalAlignment="Left" Margin="10,351,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Width="780" Grid.ColumnSpan="5" Height="73"/>
        <Button Name="BruteForce" Grid.Column="3" Content="BruteForce" HorizontalAlignment="Left" Margin="256,284,0,0" VerticalAlignment="Top" Click="BruteForce_Click"/>
    </Grid>
</Window>
